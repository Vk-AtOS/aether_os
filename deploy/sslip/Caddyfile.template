# TLS front for an install WITHOUT its own domain (KAN-75): Caddy holds 80/443, nginx sits behind it on 127.0.0.1:8080.
#
# Why: per-run previews live at https://<run-id>.preview.<host> (core/run_app/preview_token.py). With a real domain that
# is one wildcard certificate (DNS-01). On <ip>.sslip.io there is no DNS control, so Caddy issues a certificate per run
# host on first visit (on-demand TLS), and only for names the `ask` check accepts: a run-id label in front of exactly
# this preview base. That stops anyone using the server to mint certificates for arbitrary names.
#
# Placeholders are filled by render_nginx_behind_caddy.py: the public host name (e.g. 3-105-82-63.sslip.io), an optional ACME e-mail.
{
	__EMAIL_LINE__
	on_demand_tls {
		ask http://127.0.0.1:9081/ask
	}
}

# The dashboard, API and portal: certificate for the fixed host, everything else stays in nginx (rate limits, CSP,
# static dashboard). nginx trusts X-Forwarded-For only from 127.0.0.1 (set_real_ip_from), so per-IP limits still work.
__HOST__ {
	encode gzip
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-Proto https
	}
}

# Per-run preview origins: one certificate per run host, issued on demand.
*.preview.__HOST__, preview.__HOST__ {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:8100 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		# Platform credentials never reach the generated app's upstream (defence in depth, as in deploy/nginx.conf).
		header_up -X-Api-Key
		header_up -X-Org-Id
		transport http {
			read_timeout 120s
			write_timeout 120s
		}
	}
	request_body {
		max_size 10MB
	}
	header Strict-Transport-Security "max-age=63072000"
}

# Velaris public app (KAN-128): careers, scheduling, interview and signing links for people outside the organisation.
# nginx on 127.0.0.1:8081 keeps the path allowlist, header stripping, rate limits and the masked access log.
velaris.__HOST__ {
	reverse_proxy 127.0.0.1:8081
}

# Loopback only: answers Caddy's on-demand question "may I get a certificate for {query.domain}?".
http://127.0.0.1:9081 {
	bind 127.0.0.1
	@allowed expression `{query.domain}.matches("^[a-z0-9][a-z0-9-]{0,62}\\.preview\\.__HOST_RE__$")`
	respond @allowed 200
	respond 403
}
