[Unit]
Description=AetherOS PostgreSQL Backup
After=network.target postgresql.service

[Service]
Type=oneshot
User=aetheros
EnvironmentFile=/home/aether_os/.env
ExecStart=/home/aether_os/deploy/scripts/backup.sh
StandardOutput=append:/var/log/aetheros/backup.log
StandardError=append:/var/log/aetheros/backup.log
