[Unit]
Description=AetherOS AI App Factory
After=network.target

[Service]
Type=simple
User=aetheros
Group=aetheros
WorkingDirectory=/home/aether_os
EnvironmentFile=/home/aether_os/.env
Environment=PYTHONPATH=/home
ExecStart=/home/aether_os/venv/bin/uvicorn aether_os.gateway.api:create_app \
    --factory \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 4 \
    --log-level info
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aetheros
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/home/aether_os /home/aether_os/.aether_os /var/log/aetheros /var/backups/aetheros

[Install]
WantedBy=multi-user.target
