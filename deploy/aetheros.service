[Unit]
Description=AetherOS AI App Factory
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/aether_os
EnvironmentFile=/home/aether_os/.env
Environment=PYTHONPATH=/home
ExecStart=/home/aether_os/venv/bin/uvicorn aether_os.gateway.api:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 2 \
    --log-level info
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aetheros

[Install]
WantedBy=multi-user.target
