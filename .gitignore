# AetherOS .gitignore
#
# History has been fully scrubbed with git filter-repo (2026-06-01):
#   - token.txt, auth_res.json, aether_os.db.bak (pass 1)
#   - .env (pass 2)
# GitHub history is clean. Credentials exposed in old .env must be rotated.

# Sensitive runtime / auth files — never commit
token.txt
auth_res.json
*.db.bak
*.bak
run_res.json
token.json

# Strategy / acquisition documents — never commit
ACQUISITION_EMAILS.md
AETHEROS_MASTER_PLAN.md
DEPLOYMENT_READINESS_REPORT.md
incomplete_features.txt

# Playwright test artifacts and session screenshots
.playwright-mcp/
test-*.png
console-*.log
# Root-level debug/demo screenshots — not part of the codebase
/*.png
/*.jpg

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/
.python-version

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checking
.mypy_cache/
.pytype/
.pyre/

# Databases (runtime)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Logs
*.log
logs/
log/

# AetherOS runtime data
~/.aether_os/
data/

# Outputs (generated projects)
outputs/
.aether_snapshots/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Node (Aether-one had node_modules committed — prevent this)
node_modules/
package-lock.json
yarn.lock
bun.lockb

# Docker
.docker/

# Coverage
coverage.xml
*.cover

# Packaging
*.tar.gz
*.whl
*.zip

# Development/debug scripts — not for production repo
verify_sprint.py
check_frontend.py

# Claude Code agent worktrees
.claude/

# Sensitive acquisition/strategy documents — never commit to repo
AETHEROS_ACQUISITION_DUE_DILIGENCE.md
AETHEROS_MASTER_PLAN.md
DEPLOYMENT_READINESS_REPORT.md
ACQUISITION_EMAILS.md
token.txt
auth_res.json
*.db.bak
.local/
