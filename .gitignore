# AetherOS .gitignore
#
# IMPORTANT: Sensitive files (token.txt, auth_res.json, aether_os.db.bak) were
# accidentally committed previously. They have been removed from the git index via
# `git rm --cached`. A full history scrub with `git filter-repo` is still
# required before any public repository or acquisition due diligence:
#   git filter-repo --invert-paths --path token.txt --path auth_res.json --path aether_os.db.bak

# Sensitive runtime / auth files — never commit
token.txt
auth_res.json
*.db.bak
*.bak
run_res.json
token.json

# Strategy / acquisition documents — never commit
ACQUISITION_EMAILS.md
AETHEROS_MASTER_PLAN.md
DEPLOYMENT_READINESS_REPORT.md

# Playwright test artifacts
.playwright-mcp/
test-*.png
console-*.log

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/
.python-version

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checking
.mypy_cache/
.pytype/
.pyre/

# Databases (runtime)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Logs
*.log
logs/
log/

# AetherOS runtime data
~/.aether_os/
data/

# Outputs (generated projects)
outputs/
.aether_snapshots/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Node (Aether-one had node_modules committed — prevent this)
node_modules/
package-lock.json
yarn.lock
bun.lockb

# Docker
.docker/

# Coverage
coverage.xml
*.cover

# Packaging
*.tar.gz
*.whl
*.zip

# Development/debug scripts — not for production repo
verify_sprint.py
check_frontend.py

# Claude Code agent worktrees
.claude/
