DATABASE_URL=postgresql://dcsp_user:dcsp2024@localhost:5432/dcsp_db

# GitHub App (for autonomous fix PRs)
GITHUB_APP_ID=                        # from GitHub App settings page
GITHUB_APP_PRIVATE_KEY_PATH=dcsp-github-app.pem   # path to downloaded .pem file
GITHUB_WEBHOOK_SECRET=                # set this in GitHub App settings too
# OR inline the key (for Docker/K8s):
GITHUB_APP_PRIVATE_KEY=               # paste the .pem contents with \n for newlines
GITHUB_APP_SLUG=dcsp-autofix          # slug shown in your GitHub App URL

# Legacy GitHub OAuth (kept for compatibility)
GITHUB_TOKEN=your_github_token
GITLAB_TOKEN=your_gitlab_token
GITLAB_WEBHOOK_SECRET=your_secret
JENKINS_WEBHOOK_TOKEN=your_jenkins_token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
DCSP_SMTP_HOST=smtp.example.com
DCSP_SMTP_PORT=587
DCSP_SMTP_USER=user@example.com
DCSP_SMTP_PASSWORD=secret
DCSP_ALERT_FROM=alerts@dcsp.local
DCSP_ALERT_TO=devs@dcsp.local
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-coder:6.7b
