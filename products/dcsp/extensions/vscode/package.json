{
  "name": "dcsp",
  "displayName": "DCSP - Dynamic Code Self-healing Pipeline",
  "description": "Trigger AI-powered code repairs from VS Code",
  "version": "0.1.0",
  "publisher": "dcsp",
  "engines": { "vscode": "^1.74.0" },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:dcsp.repairFile",
    "onCommand:dcsp.showDashboard",
    "onCommand:dcsp.configure",
    "onCommand:dcsp.checkConnection"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dcsp.repairFile",
        "title": "DCSP: Repair Current File"
      },
      {
        "command": "dcsp.showDashboard",
        "title": "DCSP: Open Dashboard"
      },
      {
        "command": "dcsp.configure",
        "title": "DCSP: Configure Server URL"
      },
      {
        "command": "dcsp.checkConnection",
        "title": "DCSP: Check Server Connection"
      }
    ],
    "configuration": {
      "title": "DCSP",
      "properties": {
        "dcsp.serverUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "DCSP server URL"
        },
        "dcsp.apiKey": {
          "type": "string",
          "default": "",
          "description": "DCSP API key"
        },
        "dcsp.autoRepair": {
          "type": "boolean",
          "default": false,
          "description": "Auto-trigger repair on save"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "typescript": "^5.0.0"
  }
}
