# AetherOS — Environment Variables
# Copy to .env and fill in all values before running.
# NEVER commit .env to git.

# ── Quality gates ────────────────────────────────────────────────────────────
# Strict: a failed DeliveryCouncil / PreFlightCouncil check blocks the run. Keep true outside
# throw-away development (the code also defaults to true when ENVIRONMENT=production).
COUNCIL_ENABLED=true
COUNCIL_STRICT_MODE=true

# ── LLM Configuration ────────────────────────────────────────────────────────
# Primary LLM configuration
# Options: anthropic, bedrock, gemini, ollama, openrouter
PRIMARY_LLM=bedrock
ANTHROPIC_API_KEY=

# ── LLM — OpenRouter (free-tier fallback) ────────────────────────────────────
# Used as Tier 3 fallback when Anthropic and Gemini are unavailable.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── LLM — Tier 1b: Amazon Bedrock (Claude Haiku/Sonnet via AWS credits) ──────
# Create IAM user → attach AmazonBedrockFullAccess → generate access key
# Enable Claude models at: AWS Console → Bedrock → Model access
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
# Heavy tasks (codegen, review, security) — Amazon Nova Pro; light tasks — Amazon Nova Lite
# Nova models work with standard AWS credits (no Marketplace subscription needed).
# Upgrade to Claude: set BEDROCK_MODEL_HEAVY=us.anthropic.claude-sonnet-4-6 after
#   completing the AWS Marketplace subscription for Anthropic models.
BEDROCK_MODEL_HEAVY=us.amazon.nova-pro-v1:0
BEDROCK_MODEL_LIGHT=us.amazon.nova-lite-v1:0

# Ollama fallback
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT=120

# ── LLM — Tier 2: Google Gemini (used as primary if ANTHROPIC_API_KEY not set)
# Get your key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Required for SSE live-log fan-out, pipeline signals, and rate limiting.
# In docker-compose this is auto-configured; set manually for standalone deploys.
REDIS_URL=redis://localhost:6379
# Redis authentication password (strongly recommended for production).
# Run scripts/secure_redis.sh to auto-generate and apply this value.
# If set, REDIS_URL must also include the password: redis://:password@localhost:6379
REDIS_PASSWORD=your_strong_redis_password_here

# ── LLM — Amazon Bedrock toggle ───────────────────────────────────────────────
# Set to true to route LLM calls through Bedrock (requires AWS_* vars above).
# Auto-enabled when AWS_ACCESS_KEY_ID is set — this flag is only needed for IAM role auth.
BEDROCK_ENABLED=true

# ── Pipeline Job Queue (SQS) ──────────────────────────────────────────────────
# When set, pipeline runs are queued through SQS instead of running directly.
# This prevents CPU saturation under concurrent load and survives server restarts.
# Queue: aetheros-pipeline-jobs (us-east-1, account 410376035053)
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/410376035053/aetheros-pipeline-jobs
# Sign job bodies (HMAC-SHA256) so a worker refuses a message not written by the gateway: generate with
# `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`, set the SAME value on gateway and workers.
# SQS_JOB_HMAC_KEY=
# PIPELINE_MAX_CONCURRENT=2   # max simultaneous runs per server process

# ── Security (Required) ───────────────────────────────────────────────────────
# ── JWT Signing Keys — RS256 (recommended for production) ────────────────────
# Generate an RSA-2048 keypair:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Base64-encode for env var storage (single line, no newlines):
#   python3 -c "import base64; print(base64.b64encode(open('jwt_private.pem','rb').read()).decode())"
#   python3 -c "import base64; print(base64.b64encode(open('jwt_public.pem','rb').read()).decode())"
AETHER_JWT_PRIVATE_KEY_B64=your_base64_encoded_rsa_private_key_pem_here
AETHER_JWT_PUBLIC_KEY_B64=your_base64_encoded_rsa_public_key_pem_here

# ── JWT Signing Secret — HS256 (legacy fallback if RS256 keys not set) ────────
# Only used if AETHER_JWT_PRIVATE_KEY_B64 is not set. Logs a deprecation warning.
# In RS256 mode HS256 tokens are refused. Migration window only (then remove): AETHER_ACCEPT_LEGACY_HS256_TOKENS=1
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AETHER_SECRET_KEY=<generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))">

# Field-level encryption key for sensitive DB columns (LLM API keys, MFA secrets)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AETHER_FIELD_KEY=your_fernet_key_here

# Zero-trust execution secret — Bug 2 fix: must be set, no fallback
# generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AETHER_ONE_ZT_SECRET=<generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))">

# ── Admin Seed Credentials (REQUIRED — no defaults, startup fails if unset) ───
# AETHER_ADMIN_EMAIL and AETHER_ADMIN_PASS are MANDATORY. The application will
# raise RuntimeError at startup if either is missing.
# Use a strong, unique password — common/weak passwords are explicitly blocked.
# Generate a strong password: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AETHER_ADMIN_EMAIL=admin@example.com
AETHER_ADMIN_PASS=<generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))">

# ── OAuth2 Social Login ───────────────────────────────────────────────────────
# GitHub OAuth app: https://github.com/settings/developers → New OAuth App
# Set Authorization callback URL to: https://yourdomain.com/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth app: https://console.cloud.google.com → APIs & Services → Credentials
# Set Authorized redirect URI to: https://yourdomain.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── SAML SSO IdP Configuration (Okta / Azure AD) ─────────────────────────────
# Configure these from your IdP's application metadata XML.
# Okta: Applications → <app> → Sign On → View Setup Instructions
# Azure AD: Enterprise Apps → <app> → Single sign-on → SAML configuration
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
# Base64-encoded IdP signing certificate (copy from IdP metadata, no PEM headers)
SAML_IDP_CERT=

# ── Error Tracking (Sentry) ───────────────────────────────────────────────────
# Get your DSN at https://sentry.io → Settings → Projects → Client Keys
# Leave blank to disable Sentry error reporting.
SENTRY_DSN=

# ── GitHub Personal Access Token ─────────────────────────────────────────────
# Used by the SSH/GitLab fetcher and repo scanning features.
# Create at: https://github.com/settings/tokens (scopes: repo, read:org)
GITHUB_TOKEN=

# ── CORS (Bug 3 fix: never wildcard) ─────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty for SQLite default (~/.aether_os/aether_os.db)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/aether_os

# ── LLM Fallback (Ollama) ─────────────────────────────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434

# ── Pipeline ──────────────────────────────────────────────────────────────────
# AETHER_CONFIG_PATH=/path/to/config.yaml
# AETHER_REPO_ROOT=/path/to/repo  # Used for CI/CD call graph (Bug 5 fix)

# ── API Server ────────────────────────────────────────────────────────────────
# AETHER_API_HOST=0.0.0.0
# AETHER_API_PORT=8080

# ── Optional: Notifications ───────────────────────────────────────────────────
# Slack incoming webhook for pipeline/alert notifications:
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASSWORD=your_app_password

# ── Optional: GitHub App Integration ─────────────────────────────────────────
# GITHUB_APP_ID=your_app_id
# GITHUB_APP_PRIVATE_KEY_PATH=/path/to/private_key.pem
# GITHUB_WEBHOOK_SECRET=your_webhook_secret

# ── Optional: GitLab ─────────────────────────────────────────────────────────
# GITLAB_TOKEN=your_personal_access_token

# ── Dev only ─────────────────────────────────────────────────────────────────
# DB_ECHO=false

# ── Razorpay (payments — India orgs only) ────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Optional: set this in Razorpay dashboard → Webhooks → secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Stripe (payments — non-India orgs) ───────────────────────────────────────
# Obtain from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
# Set in Stripe dashboard → Developers → Webhooks → Add endpoint secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from Stripe dashboard → Products
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ── Pipeline tuning ───────────────────────────────────────────────────────────
# Seconds allowed per pipeline phase before timeout (default 600 = 10 min)
# PHASE_TIMEOUT_SECONDS=600

# ── WhatsApp (WAHA) notifications ────────────────────────────────────────────
# Override if your WAHA container is not on localhost:3000
# WAHA_URL=http://localhost:3000

# ── FDE: Run App ─────────────────────────────────────────────────────────────
# Port used when running a generated app locally (default 8001)
# RUN_APP_PORT=8001

# ── White-label branding ──────────────────────────────────────────────────────
# Override to white-label generated app headers, READMEs, and changelogs.
# Leave blank to use the default "AetherOS Factory" branding.
DEPLOYMENT_BRAND=

# ── DCSP Integration (optional) ──────────────────────────────────────────────
# Connect AetherOS pipelines to DCSP for predictive monitoring and auto-repair.
# Leave blank to disable DCSP bridge integration.
DCSP_URL=
DCSP_API_KEY=

# ─── AIR-GAPPED / LOCAL-ONLY MODE ────────────────────────────────────────────
# Set these to run 100% offline with no external API calls.
# Requires Ollama running locally: https://ollama.ai
# Recommended model: ollama pull llama3.1:8b  (or mistral, codellama)
#
# OFFLINE_MODE=true
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# LLM_PROVIDER=ollama
# PRIMARY_LLM=ollama
# RETRIEVER=duckduckgo       # No API key needed
# ANTHROPIC_API_KEY=          # Leave blank in air-gapped mode
# GOOGLE_API_KEY=             # Leave blank in air-gapped mode

# ── SCIM 2.0 IdP Provisioning (Okta / Azure AD) ──────────────────────────────
# Configure these on the server, then set the same token as the "provisioning secret"
# in your IdP (Okta: Applications → Provisioning; Azure AD: Enterprise Apps → Provisioning).
# SCIM_BEARER_TOKEN is the shared secret; SCIM_ORG_ID is the org UUID to provision into.
# Generate a token: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Alternatively, use POST /api/settings/scim/rotate (UI Settings → SCIM tab) to generate
# a per-org DB token — no env var needed for multi-tenant deployments.
# SCIM_BEARER_TOKEN=your-long-random-secret-token
# SCIM_ORG_ID=your-org-uuid-here

# ── LLM Token Pricing Overrides (USD per 1M tokens) ──────────────────────────
# Override default token prices if Anthropic changes pricing.
# Leave commented out to use the built-in defaults.
# PRICE_CLAUDE_SONNET_4_6_INPUT=3.00
# PRICE_CLAUDE_SONNET_4_6_OUTPUT=15.00
# PRICE_CLAUDE_HAIKU_4_5_INPUT=0.25
# PRICE_CLAUDE_HAIKU_4_5_OUTPUT=1.25
# PRICE_CLAUDE_OPUS_4_6_INPUT=15.00
# PRICE_CLAUDE_OPUS_4_6_OUTPUT=75.00
# PRICE_DEFAULT_INPUT=3.00
# PRICE_DEFAULT_OUTPUT=15.00

# ── Metrics API Key (RECOMMENDED — always set in production) ─────────────────
# /metrics is ALWAYS protected. If METRICS_API_KEY is not set, the server
# generates a random ephemeral key at startup and logs it at WARNING level.
# Set this explicitly so the key survives restarts and can be shared with
# your Prometheus scraper.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_API_KEY=your-secret-metrics-key

# ── Velaris (OPTIONAL: docker compose --profile velaris up) ──────────────────
# One Velaris per organisation. VELARIS_ORG must equal the AetherOS organisation id it serves.
# Key pair (owner, once):  openssl genpkey -algorithm ED25519 -out secrets/velaris_identity.pem
#                          openssl pkey -in secrets/velaris_identity.pem -pubout -out secrets/velaris_identity.pub.pem
# VELARIS_IMAGE=velaris:local
# VELARIS_ORG=<AetherOS organisation id>
# VELARIS_API_URL=http://velaris:8730
# VELARIS_API_SECRET=<openssl rand -hex 32>
# VELARIS_IDENTITY_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# VELARIS_SMOKE_ORG=<same as VELARIS_ORG; deploy.sh sends one signed request to Velaris after each deploy>
